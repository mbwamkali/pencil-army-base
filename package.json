    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/patrick-hand": "^5.3.0"
